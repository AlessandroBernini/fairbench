name: Discover new GGUF models

on:
  schedule:
    - cron: '0 9 * * 1'  # Ogni lunedì 09:00 UTC
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: write

jobs:
  discover:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      
      - name: Install dependencies
        run: pip install huggingface_hub
      
      - name: Discover new models and check for outdated ones
        run: python scripts/cron/discover_models.py
      
      - name: Create PR with new and old models
        uses: peter-evans/create-pull-request@v6
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
          branch: discover/new-models
          title: "📦 New GGUF models & outdated model cleanup"
          body: |
            ## New models to review
            See `discovered/new-models-*.md` for proposed additions.
            
            ## Outdated models to remove
            See `discovered/old-models-*.md` for models older than 365 days.
            
            Please review and merge to keep the registry current.
          base: main
