# FairBench PyPI Publish Configuration
# Copy this file to .pypirc and fill in your credentials
#
# To get an API token:
#   1. Go to https://pypi.org/manage/account/
#   2. Click "Add API token"
#   3. Copy the token and paste it below

[pypi]
username = __token__
password = pypi-AgEIcHlwaS5vcmc....

